    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID33",
      "SecondaryAttribute": "Coder details",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"max-width:680px;font-size:16px;color:#1f2933;\"><p style=\"font-size:16px;font-weight:600;color:#1f2933;margin:18px 0 6px;padding-top:12px;border-top:1px solid #e3e7ec;\">2. Coder details</p></div>",
