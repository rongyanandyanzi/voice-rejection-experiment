    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID85",
      "SecondaryAttribute": "Note 2 tools",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"max-width:680px;font-size:16px;color:#1f2933;\"><p style=\"font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#2f5d8a;margin:0 0 4px;\">Batch 3 complete</p><p style=\"font-size:21px;font-weight:600;line-height:1.35;color:#1f2933;margin:0 0 12px;\">Batch 3 complete.</p><div style=\"margin:0 0 12px;\"><button type=\"button\" id=\"cs-tool-review\" style=\"margin:0 8px 8px 0;padding:6px 12px;font:inherit;font-size:13px;border:1px solid #bcc6cf;border-radius:4px;background:#fff;color:#2f5d8a;cursor:pointer;\">Review this batch</button><div id=\"cs-panel-review\" style=\"display:none;border:1px solid #d9dee5;border-radius:8px;padding:10px 14px;margin:4px 0 10px;background:#f6f8fa;font-size:14px;\"><ol style=\"margin:0;padding-left:20px;\"><li style=\"margin:0 0 4px\">The page kept freezing whenever I tried to go back. <span style=\"font-size:12px;color:#2f5d8a;\">&mdash; ${q://QID69/ChoiceGroup/SelectedChoices}</span></li><li style=\"margin:0 0 4px\">The rating scale labels were the wrong way round compared to the earlier pages. <span style=\"font-size:12px;color:#2f5d8a;\">&mdash; ${q://QID71/ChoiceGroup/SelectedChoices}</span></li><li style=\"margin:0 0 4px\">Could you tell me when the results will be published? <span style=\"font-size:12px;color:#2f5d8a;\">&mdash; ${q://QID73/ChoiceGroup/SelectedChoices}</span></li><li style=\"margin:0 0 4px\">It was a bit longer than I'd have liked. <span style=\"font-size:12px;color:#2f5d8a;\">&mdash; ${q://QID75/ChoiceGroup/SelectedChoices}</span></li><li style=\"margin:0 0 4px\">The questions about my family were quite personal. <span style=\"font-size:12px;color:#2f5d8a;\">&mdash; ${q://QID77/ChoiceGroup/SelectedChoices}</span></li><li style=\"margin:0 0 4px\">Is there a follow-up study I can sign up for? <span style=\"font-size:12px;color:#2f5d8a;\">&mdash; ${q://QID79/ChoiceGroup/SelectedChoices}</span></li><li style=\"margin:0 0 4px\">The payment arrived quicker than usual, thanks. <span style=\"font-size:12px;color:#2f5d8a;\">&mdash; ${q://QID81/ChoiceGroup/SelectedChoices}</span></li><li style=\"margin:0 0 4px\">Please could you send me a summary of what you found. <span style=\"font-size:12px;color:#2f5d8a;\">&mdash; ${q://QID83/ChoiceGroup/SelectedChoices}</span></li></ol></div></div><div style=\"border-left:4px solid #2f7a4a;background:#eef7f0;border-radius:6px;padding:12px 16px;margin:0 0 14px;line-height:1.6;\">Both choices below lead to the same last few questions and the <b>same payment</b>.</div></div>",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "QuestionJS": "// Note 2 pages: the two tools, \"Review this batch\" and \"Why the rules are this way\", are collapsed\n// sections above the choice or the essay box. Each open is counted and the time of the first open\n// recorded, into the hidden carrier questions on the page (review_opens, why_opens,\n// first_tool_open_ms) and embedded data.\nQualtrics.SurveyEngine.addOnload(function () {\n  var question = this;\n  var openedAt = Date.now();\n  var counts = { review: 0, why: 0 };\n  var firstOpen = 0;\n  var HIDDEN = { review_opens: 0, why_opens: 1, first_tool_open_ms: 2 };\n  function setHidden(index, value) {\n    var inputs = document.querySelectorAll(\"input[type=text]\");\n    var input = inputs[index];\n    if (!input) return;\n    var setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, \"value\").set;\n    setter.call(input, value == null ? \"\" : String(value));\n    input.dispatchEvent(new Event(\"input\", { bubbles: true }));\n    input.dispatchEvent(new Event(\"change\", { bubbles: true }));\n  }\n  var isBatch2Essay = Boolean(question.getQuestionContainer().querySelector(\"textarea\"));\n  var suffix = isBatch2Essay ? \"_essay\" : \"_choice\";\n  function record() {\n    try {\n      Qualtrics.SurveyEngine.setEmbeddedData(\"review_opens\" + suffix, String(counts.review));\n      Qualtrics.SurveyEngine.setEmbeddedData(\"why_opens\" + suffix, String(counts.why));\n      Qualtrics.SurveyEngine.setEmbeddedData(\"first_tool_open_ms\" + suffix, firstOpen ? String(firstOpen - openedAt) : \"\");\n    } catch (error) {}\n    setHidden(HIDDEN.review_opens, counts.review);\n    setHidden(HIDDEN.why_opens, counts.why);\n    setHidden(HIDDEN.first_tool_open_ms, firstOpen ? firstOpen - openedAt : \"\");\n  }\n  [\"review\", \"why\"].forEach(function (name) {\n    var button = document.getElementById(\"cs-tool-\" + name);\n    var panel = document.getElementById(\"cs-panel-\" + name);\n    if (!button || !panel) return;\n    button.addEventListener(\"click\", function () {\n      var open = panel.style.display !== \"none\" && panel.style.display !== \"\";\n      if (!open) {\n        counts[name] += 1;\n        if (!firstOpen) firstOpen = Date.now();\n        panel.style.display = \"block\";\n        button.textContent = name === \"review\" ? \"Hide this batch\" : \"Hide the rules\";\n      } else {\n        panel.style.display = \"none\";\n        button.textContent = name === \"review\" ? \"Review this batch\" : \"Why the rules are this way\";\n      }\n      record();\n    });\n  });\n  record();\n});\n",
        "QuestionID": "QID85",
        "DataExportTag": "note2_tools_choice",
        "QuestionDescription": "Note 2 tools",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID86",
      "SecondaryAttribute": "review_opens",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "review_opens",
        "QuestionType": "TE",
        "Selector": "SL",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "Validation": {
          "Settings": {
            "ForceResponse": "OFF",
            "Type": "None"
          }
        },
        "QuestionJS": "// Hidden carrier question (single-line Text Entry) on the waiting page. The waiting page script\n// writes the reply into these fields; they are saved with the page like any answer, drive the\n// branch logic and feed piped text on the message page. This script only hides the question.\nQualtrics.SurveyEngine.addOnload(function () {\n  var container = this.getQuestionContainer();\n  if (container) container.style.display = \"none\";\n});\n",
        "QuestionID": "QID86",
        "DataExportTag": "h_review_opens_choice",
        "QuestionDescription": "review_opens",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
