    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "Consent text",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"max-width:680px;font-size:16px;color:#1f2933;\"><p style=\"font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#2f5d8a;margin:0 0 4px;\">Paid coding work</p><p style=\"font-size:21px;font-weight:600;line-height:1.35;color:#1f2933;margin:0 0 12px;\">One short shift as a Feedback Coder</p><p style=\"margin:0 0 12px;line-height:1.6;\">You are being hired for one short shift as a Feedback Coder on our comment-coding project. You will sort short comments that people left at the end of earlier online studies into categories.</p><div style=\"border-left:4px solid #2f5d8a;background:#f3f6fa;border-radius:6px;padding:12px 16px;margin:0 0 14px;line-height:1.6;\"><p style=\"margin:0 0 6px;font-weight:600;color:#2f5d8a;\">How the shift works</p><ul style=\"margin:0;padding-left:20px;\"><li style=\"margin:0 0 4px;\"><b>Three short batches</b> of comments, about <b>18 minutes</b> in total.</li><li style=\"margin:0 0 4px;\">The <b>coding supervisor</b> checks your work against a reference key, sets the coding rules, may change any label you give, and issues each batch.</li><li style=\"margin:0 0 4px;\">Your <b>quality bonus</b> depends on how your batches are rated.</li></ul></div><div style=\"border-left:4px solid #c98a12;background:#fff8e8;border-radius:6px;padding:12px 16px;margin:0 0 14px;line-height:1.6;\"><p style=\"margin:0 0 6px;font-weight:600;color:#c98a12;\">Please note</p><ul style=\"margin:0;padding-left:20px;\"><li style=\"margin:0 0 4px;\">Some steps are optional. Using or skipping them <b>does not change your payment or bonus</b>.</li><li style=\"margin:0 0 4px;\">The supervisor may reply to anything you send. Replies can be <b>brief or critical</b>, as workplace feedback sometimes is.</li></ul></div><p style=\"font-size:13px;line-height:1.5;color:#5f6b7a;margin:0;\">Your answers are stored anonymously under your Prolific ID. You can stop at any time by closing the page.</p></div>",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "QuestionJS": "// Consent page: wakes the service so it is awake by the time a note is sent, and clears any state\n// left in sessionStorage by an earlier preview in the same tab.\nQualtrics.SurveyEngine.addOnload(function () {\n  var SERVICE_URL = \"https://aetheria-gardens-messages.onrender.com\";\n  try { fetch(SERVICE_URL + \"/api/health\", { method: \"GET\", mode: \"cors\", cache: \"no-store\" }).catch(function () {}); } catch (error) {}\n  try {\n    Object.keys(sessionStorage).forEach(function (key) { if (key.indexOf(\"cs_\") === 0) sessionStorage.removeItem(key); });\n  } catch (error) {}\n});\n",
        "QuestionID": "QID1",
        "DataExportTag": "consent_text",
        "QuestionDescription": "Consent text",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID2",
      "SecondaryAttribute": "Are you willing to take part in this shift?",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "Are you willing to take part in this shift?",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "Choices": {
          "1": {
            "Display": "Yes, I agree, start the shift"
          },
          "2": {
            "Display": "No, I do not want to take part"
          }
        },
        "ChoiceOrder": [
          "1",
          "2"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "ForceResponseType": "ON",
            "Type": "None"
          }
        },
        "NextChoiceId": 3,
        "NextAnswerId": 1,
        "QuestionID": "QID2",
        "DataExportTag": "consent",
        "QuestionDescription": "Are you willing to take part in this shift?",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID3",
      "SecondaryAttribute": "Training: rules",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"max-width:680px;font-size:16px;color:#1f2933;\"><p style=\"font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#2f5d8a;margin:0 0 4px;\">Training</p><p style=\"font-size:21px;font-weight:600;line-height:1.35;color:#1f2933;margin:0 0 12px;\">Your job and the coding rules</p><p style=\"margin:0 0 12px;line-height:1.6;\">Each comment goes into one of five categories.</p><div style=\"margin:0 0 16px;\"><div style=\"display:flex;gap:12px;align-items:baseline;padding:8px 0;border-bottom:1px solid #eef1f4;\"><span style=\"flex:0 0 84px;font-size:12px;font-weight:600;letter-spacing:.04em;color:#2f5d8a;\">TECH</span><span><b>Technical problem.</b> Something in the study did not work: a page, a clip, a button, the timing, or how it displayed.</span></div><div style=\"display:flex;gap:12px;align-items:baseline;padding:8px 0;border-bottom:1px solid #eef1f4;\"><span style=\"flex:0 0 84px;font-size:12px;font-weight:600;letter-spacing:.04em;color:#2f5d8a;\">WORDING</span><span><b>Unclear instruction or question.</b> An instruction, question or answer option was confusing or hard to interpret.</span></div><div style=\"display:flex;gap:12px;align-items:baseline;padding:8px 0;border-bottom:1px solid #eef1f4;\"><span style=\"flex:0 0 84px;font-size:12px;font-weight:600;letter-spacing:.04em;color:#2f5d8a;\">LENGTH</span><span><b>Length, pace or repetition.</b> How long, how fast, how repetitive or how demanding the study was.</span></div><div style=\"display:flex;gap:12px;align-items:baseline;padding:8px 0;border-bottom:1px solid #eef1f4;\"><span style=\"flex:0 0 84px;font-size:12px;font-weight:600;letter-spacing:.04em;color:#2f5d8a;\">PAYMENT</span><span><b>Payment or stated time.</b> The fee, the bonus, or whether the time in the listing was accurate.</span></div><div style=\"display:flex;gap:12px;align-items:baseline;padding:8px 0;border-bottom:1px solid #eef1f4;\"><span style=\"flex:0 0 84px;font-size:12px;font-weight:600;letter-spacing:.04em;color:#2f5d8a;\">CONTENT</span><span><b>Reaction to the subject matter.</b> Interest, discomfort, disagreement, or wanting to explain an answer.</span></div></div><div style=\"border-left:4px solid #c98a12;background:#fff8e8;border-radius:6px;padding:12px 16px;margin:0 0 14px;line-height:1.6;\"><b>Choose one category for each comment.</b></div><p style=\"margin:0 0 12px;line-height:1.6;\">After batch 1 and after the last batch you can attach a note to the coding supervisor if you want to. It is optional, and your batch is rated the same either way.</p><p style=\"margin:0 0 12px;line-height:1.6;\">Two practice comments come first.</p><p style=\"font-size:13px;line-height:1.5;color:#5f6b7a;margin:0;\">Codebook v3.1 &middot; rules set by the coding supervisor</p></div>",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "QuestionID": "QID3",
        "DataExportTag": "training_rules",
        "QuestionDescription": "Training: rules",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID4",
      "SecondaryAttribute": "Practice 1 of 2   How to label this comment  Choose one category for each comment.  If a comment men",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p style=\"font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:#667;\">Practice 1 of 2</p><div style=\"border:1px solid #d9dee5;border-radius:8px;padding:10px 14px;margin:10px 0 14px;background:#f6f8fa;font-size:14px;\"><b>How to label this comment</b><p style=\"margin:6px 0 0\">Choose one category for each comment.</p><p style=\"margin:4px 0 0\">If a comment mentions more than one thing, choose the one it is mainly about.</p><p style=\"margin:4px 0 0\">There is no &ldquo;other&rdquo; option. Every comment gets one of the five categories.</p></div><p style=\"font-size:17px;line-height:1.5;border-left:3px solid #bcc6cf;padding-left:12px;\">The audio clip on page 2 wouldn't play, so I had to guess what it said.</p><p>Which category does this comment belong to?</p>",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "Choices": {
          "1": {
            "Display": "<b>TECH</b> &middot; Technical problem"
          },
          "2": {
            "Display": "<b>WORDING</b> &middot; Unclear instruction or question"
          },
          "3": {
            "Display": "<b>LENGTH</b> &middot; Length, pace or repetition"
          },
          "4": {
            "Display": "<b>PAYMENT</b> &middot; Payment or stated time"
          },
          "5": {
            "Display": "<b>CONTENT</b> &middot; Reaction to the subject matter"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3",
          "4",
          "5"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "ForceResponseType": "ON",
            "Type": "None"
          }
        },
        "NextChoiceId": 6,
        "NextAnswerId": 1,
        "QuestionID": "QID4",
        "DataExportTag": "practice_1",
        "QuestionDescription": "Practice 1 of 2   How to label this comment  Choose one category for each comment.  If a comment men",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID5",
      "SecondaryAttribute": "Practice 1 feedback",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"max-width:680px;font-size:16px;color:#1f2933;\"><p style=\"font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#2f5d8a;margin:0 0 4px;\">Practice 1 of 2</p><p style=\"font-size:21px;font-weight:600;line-height:1.35;color:#1f2933;margin:0 0 12px;\">Answer</p><p style=\"font-size:16px;line-height:1.5;border-left:3px solid #bcc6cf;padding-left:12px;color:#5f6b7a;margin:0 0 12px;\">The audio clip on page 2 wouldn't play, so I had to guess what it said.</p><div style=\"border-left:4px solid #2f7a4a;background:#eef7f0;border-radius:6px;padding:12px 16px;margin:0 0 14px;line-height:1.6;\"><b>TECH.</b> The comment reports that part of the study did not work. It mentions only one thing.</div></div>",
