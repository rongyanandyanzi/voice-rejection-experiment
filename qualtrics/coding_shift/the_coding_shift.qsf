    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID23",
      "SecondaryAttribute": "Batch 1 &middot; comment 8 of 8  Found the questions about my health a bit intrusive tbh, and the pa",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p style=\"font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:#667;\">Batch 1 &middot; comment 8 of 8</p><p style=\"font-size:17px;line-height:1.5;border-left:3px solid #bcc6cf;padding-left:12px;margin:12px 0 6px;\">Found the questions about my health a bit intrusive tbh, and the page froze when I hit submit.</p><p>Which category does this comment belong to?</p>",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "Choices": {
          "1": {
            "Display": "<b>TECH</b> &middot; Technical problem"
          },
          "2": {
            "Display": "<b>WORDING</b> &middot; Unclear instruction or question"
          },
          "3": {
            "Display": "<b>LENGTH</b> &middot; Length, pace or repetition"
          },
          "4": {
            "Display": "<b>PAYMENT</b> &middot; Payment or stated time"
          },
          "5": {
            "Display": "<b>CONTENT</b> &middot; Reaction to the subject matter"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3",
          "4",
          "5"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "ForceResponseType": "ON",
            "Type": "None"
          }
        },
        "NextChoiceId": 6,
        "NextAnswerId": 1,
        "QuestionJS": "// Last comment of batch 1: records when batch 1 was submitted. The waiting page measures the fixed\n// delay T from this moment, the same T for everyone, whether or not a note follows.\nQualtrics.SurveyEngine.addOnPageSubmit(function () {\n  var now = Date.now();\n  try { if (!sessionStorage.getItem(\"cs_batch1_submit_ms\")) sessionStorage.setItem(\"cs_batch1_submit_ms\", String(now)); } catch (error) {}\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"batch1_submit_at\", new Date(now).toISOString()); } catch (error) {}\n});\n",
        "QuestionID": "QID23",
        "DataExportTag": "b1_8",
        "QuestionDescription": "Batch 1 &middot; comment 8 of 8  Found the questions about my health a bit intrusive tbh, and the pa",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
