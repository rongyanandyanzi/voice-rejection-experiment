    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID72",
      "SecondaryAttribute": "Batch 2: attach a note, or finish without one?",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "Batch 2: attach a note, or finish without one?",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "Choices": {
          "1": {
            "Display": "Attach a note to this batch"
          },
          "2": {
            "Display": "Finish this batch without a note"
          }
        },
        "ChoiceOrder": [
          "1",
          "2"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "ForceResponseType": "ON",
            "Type": "None"
          }
        },
        "NextChoiceId": 3,
        "NextAnswerId": 1,
        "QuestionJS": "// Note choice page (batch 1 or batch 2): \"Attach a note\" / \"Finish without a note\", shown in a\n// random order by Qualtrics. Records the time the batch was submitted, which anchors the fixed\n// delay T before the supervisor's messages appear, and which button came first.\nQualtrics.SurveyEngine.addOnload(function () {\n  var question = this;\n  var tag = question.getQuestionInfo().QuestionText.indexOf(\"Batch 2\") >= 0 ? \"2\" : \"1\";\n  var first = question.getQuestionContainer().querySelector(\"label.SingleAnswer, .ChoiceStructure label\");\n  var order = first && /attach/i.test(first.textContent) ? \"attach_first\" : \"finish_first\";\n  try { Qualtrics.SurveyEngine.setEmbeddedData(\"n\" + tag + \"_button_order\", order); } catch (error) {}\n});\nQualtrics.SurveyEngine.addOnPageSubmit(function () {\n  var isBatch2 = this.getQuestionInfo().QuestionText.indexOf(\"Batch 2\") >= 0;\n  var now = Date.now();\n  var key = isBatch2 ? \"cs_batch2_submit_ms\" : \"cs_batch1_submit_ms\";\n  try { if (!sessionStorage.getItem(key)) sessionStorage.setItem(key, String(now)); } catch (error) {}\n  try { Qualtrics.SurveyEngine.setEmbeddedData(isBatch2 ? \"batch2_submit_at\" : \"batch1_submit_at\", new Date(now).toISOString()); } catch (error) {}\n});\n",
        "QuestionID": "QID72",
        "DataExportTag": "note2_choice",
        "QuestionDescription": "Batch 2: attach a note, or finish without one?",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Randomization": {
          "Advanced": null,
          "TotalRandSubset": "",
          "Type": "All"
        }
      }
    },
    {
