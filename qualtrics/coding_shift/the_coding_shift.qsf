    {
      "SurveyID": "SV_51dc512c6f29ce9",
      "Element": "SQ",
      "PrimaryAttribute": "QID7",
      "SecondaryAttribute": "Practice 2 feedback",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><b>Practice 2: answer</b></p><p><span style=\"color:#667\">Question 7 was really confusing, I wasn't sure if it meant my current job or my last one. Also a bit long.</span></p><p><b>WORDING.</b> The comment mentions two things and is mainly about the confusing question, so that is the category. The remark about length is not recorded.</p><p>Batch 1 starts on the next page. Your labels there count.</p>",
        "QuestionType": "DB",
