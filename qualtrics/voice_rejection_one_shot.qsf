    {
      "SurveyID": "SV_82351c2d3f0f497",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "Consent text",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>About this task</strong></p><p>This task is run by a market research company. Businesses ask the company to collect outside reviews of their plans from people who are not part of the business.</p><p>Today’s client is Aetheria Gardens, a theme park. Its owner wants the park’s staffing plan reviewed by outsiders before the plan goes ahead. You will read the plan and the figures behind it and write a short review for the manager who drew it up.</p><p>The manager answers reviews in writing during today’s review session and rates each review for usefulness. Reviews the manager rates as useful earn a bonus on top of the base payment.</p><p>Are you willing to take part in this task?</p>",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "QuestionJS": "// Consent page: question JavaScript.\n// Wakes the free Render instance so it is awake by the time the participant reaches the waiting\n// page (a sleeping free instance takes up to a minute to answer its first request).\n// Replace SERVICE_URL with the deployed service origin, no trailing slash.\nQualtrics.SurveyEngine.addOnload(function () {\n  var SERVICE_URL = \"https://aetheria-gardens-messages.onrender.com\";\n  try {\n    fetch(SERVICE_URL + \"/api/health\", { method: \"GET\", mode: \"cors\", cache: \"no-store\" }).catch(function () {});\n  } catch (error) {}\n});\n",
        "QuestionID": "QID1",
        "DataExportTag": "consent_text",
        "QuestionDescription": "Consent text",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
      "SurveyID": "SV_82351c2d3f0f497",
      "Element": "SQ",
      "PrimaryAttribute": "QID2",
      "SecondaryAttribute": "Are you willing to take part in this task?",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "Are you willing to take part in this task?",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "Choices": {
          "1": {
            "Display": "Yes, I am willing to take part"
          },
          "2": {
            "Display": "No, I do not want to take part"
          }
        },
        "ChoiceOrder": [
          "1",
          "2"
        ],
        "Validation": {
          "Settings": {
