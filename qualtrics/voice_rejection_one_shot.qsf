    {
      "SurveyID": "SV_3b0d6e803297aa6",
      "Element": "SQ",
      "PrimaryAttribute": "QID19",
      "SecondaryAttribute": "Manager message",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>Reply from the park manager</strong></p><div style=\"max-width:640px;margin:0 auto;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n  <div style=\"border:1px solid #d9dee5;border-radius:12px;overflow:hidden;background:#ffffff;\">\n    <div style=\"background:#f4f6f9;padding:12px 16px;border-bottom:1px solid #e3e7ec;font-size:14px;color:#556270;\">\n      Aetheria Gardens &middot; Team messages\n    </div>\n    <div style=\"padding:16px;\">\n      <div style=\"display:flex;justify-content:flex-end;margin-bottom:16px;\">\n        <div style=\"max-width:82%;background:#e8f0fe;border-radius:14px 14px 4px 14px;padding:10px 14px;font-size:15px;line-height:1.45;color:#1f2933;\">\n          <div style=\"font-size:12px;color:#66707a;margin-bottom:4px;\">You &middot; to Park Manager</div>\n          <span id=\"vr-proposal-echo\">${q://QID10/ChoiceTextEntryValue}</span>\n        </div>\n      </div>\n      <div style=\"display:flex;gap:10px;align-items:flex-start;\">\n        <div style=\"flex:0 0 36px;width:36px;height:36px;border-radius:50%;background:#2f5d8a;color:#ffffff;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:13px;\">PM</div>\n        <div style=\"max-width:82%;\">\n          <div style=\"font-size:12px;color:#66707a;margin-bottom:4px;\">Park Manager &middot; just now</div>\n          <div style=\"background:#f1f3f5;border-radius:4px 14px 14px 14px;padding:10px 14px;font-size:15px;line-height:1.45;color:#1f2933;margin-bottom:8px;\"><span id=\"vr-rejection-msg1\">${q://QID13/ChoiceTextEntryValue}</span></div>\n          <div style=\"background:#f1f3f5;border-radius:14px;padding:10px 14px;font-size:15px;line-height:1.45;color:#1f2933;\"><span id=\"vr-rejection-msg2\">${q://QID14/ChoiceTextEntryValue}</span></div>\n        </div>\n      </div>\n    </div>\n    <div style=\"padding:10px 16px;border-top:1px solid #e3e7ec;font-size:13px;color:#77818b;\">\n      The manager has closed this thread. Replies are not possible here.\n    </div>\n  </div>\n</div><p><span style=\"color:#667;\">Click Next when you have read the reply.</span></p>",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "QuestionJS": "// Manager message page: question JavaScript on the Text/Graphic question holding the card.\n// Piped text fills the card from the saved embedded data; if a slot is empty (for example when the\n// embedded value was not saved yet), the value kept in sessionStorage by the waiting page is used.\nQualtrics.SurveyEngine.addOnload(function () {\n  var slots = { \"vr-proposal-echo\": \"vr_proposal\", \"vr-rejection-msg1\": \"vr_rejection_msg1\", \"vr-rejection-msg2\": \"vr_rejection_msg2\" };\n  Object.keys(slots).forEach(function (id) {\n    var el = document.getElementById(id);\n    if (!el || el.textContent.trim()) return;\n    var value = \"\";\n    try { value = sessionStorage.getItem(slots[id]) || \"\"; } catch (error) {}\n    if (value) el.textContent = value;\n  });\n});\n",
        "QuestionID": "QID19",
        "DataExportTag": "manager_message",
        "QuestionDescription": "Manager message",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
      "SurveyID": "SV_3b0d6e803297aa6",
