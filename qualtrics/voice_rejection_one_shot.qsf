        "Validation": {
          "Settings": {
            "ForceResponse": "OFF",
            "Type": "None"
          }
        },
        "QuestionJS": "// Hidden carrier question (single-line Text Entry) on the waiting page. The waiting page script\n// writes the reply into these fields; they are saved with the page like any answer, drive the\n// branch logic and feed piped text on the message page. This script only hides the question.\nQualtrics.SurveyEngine.addOnload(function () {\n  var container = this.getQuestionContainer();\n  if (container) container.style.display = \"none\";\n});\n",
        "QuestionID": "QID12",
        "DataExportTag": "rejection_status_q",
        "QuestionDescription": "rejection status",
        "Language": [],
        "DefaultChoices": false,
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        }
      }
    },
    {
      "SurveyID": "SV_82351c2d3f0f497",
      "Element": "SQ",
      "PrimaryAttribute": "QID13",
      "SecondaryAttribute": "rejection message 1",
      "TertiaryAttribute": null,
