    {
      "SurveyID": "SV_3b0d6e803297aa6",
      "Element": "SQ",
      "PrimaryAttribute": "QID28",
      "SecondaryAttribute": "Perceived reasons for the manager’s response   Please indicate why you think the manager rejected yo",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>Perceived reasons for the manager’s response</strong></p><p>Please indicate why you think the manager rejected your suggestion about the labor plan.</p><p><em>The manager rejected my suggestion because...</em></p>",
        "QuestionType": "Matrix",
        "Selector": "Likert",
        "SubSelector": "SingleAnswer",
        "Configuration": {
          "QuestionDescriptionOption": "UseText",
          "TextPosition": "inline",
          "ChoiceColumnWidth": 30,
          "RepeatHeaders": "none",
          "WhiteSpace": "ON",
          "MobileFirst": true
        },
        "Choices": {
          "1": {
            "Display": "The manager was influenced by their emotions."
          },
          "2": {
            "Display": "The manager wanted to demonstrate their authority."
          },
          "3": {
            "Display": "The manager personally disliked me."
          },
          "4": {
            "Display": "My proposal for improvement was mediocre."
          },
          "5": {
            "Display": "My suggestion did not really improve the current methods or practices."
          },
          "6": {
            "Display": "The changes I suggested for work arrangements did not really help much."
          },
          "7": {
            "Display": "I made impractical recommendations about how to fix work-related problems."
          },
          "8": {
            "Display": "My suggestion was not very useful."
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3",
          "4",
          "5",
          "6",
          "7",
          "8"
        ],
        "Answers": {
          "1": {
            "Display": "1<br>Strongly disagree"
          },
          "2": {
            "Display": "2<br>Disagree"
