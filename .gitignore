# Participant data and analysis results never leave this machine. The analysis scripts
# themselves are tracked so the code that produces a result is versioned and shared, while
# the result and the data behind it are not.
data/
participants.csv
interactions.csv
survey_responses.csv
ai_requests.csv
experiment_data.csv
experiment_data.xlsx
data_export_*/
pilot_exports/
outputs/

__pycache__/
*.pyc
.pnpm-store/
.DS_Store
node_modules/

# Local environment variables and API keys
.env
.env.*
!.env.example
*.local

# Secret/key files
*.pem
*.key
*.p8
*.p12
*.crt

# Logs and local runtime output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
